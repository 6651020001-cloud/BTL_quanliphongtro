// ================= SAP XEP =================

void sapxepMenu()
{
    int luaChon;

    do
    {
        cout << "\n============= SAP XEP =============\n";
        cout << "1. Sap xep phong theo gia\n";
        cout << "2. Sap xep hoa don theo tong tien\n";
        cout << "0. Quay lai\n";
        cout << "===================================\n";
        cout << "Nhap lua chon: ";
        luaChon = nhapSoNguyen();

        switch(luaChon)
        {
            case 1:
                sapXepPhong();
                break;
            case 2:
                sapXepHoaDon();
                break;
            case 0:
                break;
            default:
                cout << "Lua chon khong hop le!\n";
        }
    }while(luaChon != 0);
}

void sapXepPhong()
{
    if(danhSachPhong.empty())
    {
        cout << "Danh sach phong dang rong!\n";
        return;
    }

    int kieu;
    cout << "\n1. Gia tang dan\n";
    cout << "2. Gia giam dan\n";
    cout << "0. Huy\n";
    cout << "Nhap lua chon: ";
    kieu = nhapSoNguyen();

    if(kieu == 0)
        return;

    // insertion sort
    for(int i = 1; i < (int)danhSachPhong.size(); i++)
    {
        Phong x = danhSachPhong[i];
        int j = i - 1;

        if(kieu == 1)
        {
            while(j >= 0 && danhSachPhong[j].giaPhong > x.giaPhong)
            {
                danhSachPhong[j + 1] = danhSachPhong[j];
                j--;
            }
        }
        else if(kieu == 2)
        {
            while(j >= 0 && danhSachPhong[j].giaPhong < x.giaPhong)
            {
                danhSachPhong[j + 1] = danhSachPhong[j];
                j--;
            }
        }
        else
        {
            cout << "Lua chon khong hop le!\n";
            return;
        }

        danhSachPhong[j + 1] = x;
    }

    luuDuLieu();
    cout << "\nDa sap xep phong thanh cong!\n";
    hienThiPhong();
}

